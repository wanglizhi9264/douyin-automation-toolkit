{
  "manifest_version": 3,
  "name": "抖音备份",
  "version": "0.8.6",
  "description": "将喜欢、收藏和所选关注作者的作品备份到本地文件夹，支持并行下载、断点继续和闲时整理。",
  "action": {
    "default_title": "抖音备份",
    "default_icon": {
      "16": "src/icons/archive-16.png",
      "32": "src/icons/archive-32.png",
      "48": "src/icons/archive-48.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": [
    "storage",
    "tabs",
    "downloads",
    "downloads.ui"
  ],
  "host_permissions": [
    "https://www.douyin.com/*",
    "https://*.douyin.com/*",
    "https://*.douyinpic.com/*",
    "https://*.douyinvod.com/*",
    "https://*.douyinstatic.com/*",
    "https://*.byteimg.com/*",
    "https://*.bytecdntp.com/*",
    "https://*.bytedance.com/*",
    "https://*.snssdk.com/*",
    "https://*.zjcdn.com/*",
    "https://*.pstatp.com/*",
    "https://*.bytecdn.cn/*",
    "https://*.ibytedtos.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.douyin.com/*"
      ],
      "js": [
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "https://www.douyin.com/*"
      ],
      "resources": [
        "src/injected.js",
        "src/content.css",
        "src/sidebar/index.html",
        "src/sidebar/style.css",
        "src/shared/report.js",
        "src/folder-picker/index.html",
        "src/folder-picker/app.js",
        "src/shared/db.js",
        "src/shared/state.js",
        "src/shared/api.js",
        "src/shared/liked-sync.js",
        "src/shared/bookmarked-sync.js",
        "src/shared/download.js",
        "src/shared/download-record.js",
        "src/shared/download-index.js",
        "src/shared/performance.js",
        "src/shared/events.js",
        "src/core/media.js",
        "src/core/engine.js",
        "src/core/sources.js",
        "src/core/model.js",
        "src/archive/repository.js",
        "src/archive/fs.js",
        "src/archive/layout.js",
        "src/archive/naming.js",
        "src/maintenance/hash-worker.js",
        "src/maintenance/organize.js",
        "src/maintenance/author-folders.js",
        "src/maintenance/names.js",
        "src/icons/archive.svg",
        "src/sidebar/modern-app.js",
        "src/core/progress.js",
        "src/shared/http.js",
        "src/core/retry.js",
        "src/archive/report.js",
        "src/core/pagination.js",
        "src/maintenance/measure.js"
      ]
    }
  ],
  "icons": {
    "16": "src/icons/archive-16.png",
    "32": "src/icons/archive-32.png",
    "48": "src/icons/archive-48.png",
    "128": "src/icons/archive-128.png"
  }
}
